<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    亲吻导演台：底栏按钮，打开后从当前地图里任选两个 pawn 指定它们亲吻。
    存在的理由：右键菜单这条路对"玩家管不着的 pawn"永远不通（原版 FloatMenuContext 先按
    CanTakeOrder 过滤，敌人连被选中都做不到）。零 Harmony 下唯一干净的入口是自建窗口，
    由窗口直接对目标 pawn 起 job —— 不经过下令链，因此不需要它通过。
    按钮文本走 DefInjected/MainButtonDef/，不写在这里。
  -->
  <MainButtonDef>
    <defName>MWAH_KissDirector</defName>
    <label>kiss director</label>
    <description>Pick any two pawns on the map and make them kiss - including pawns you do not control.</description>
    <tabWindowClass>Mwah.Window_KissDirector</tabWindowClass>
    <order>900</order>
    <closesWorldView>true</closesWorldView>
  </MainButtonDef>
</Defs>
