<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    亲吻 job。双方各自跑同一个 JobDef（镜像 job，骨架沿用原版 JobDriver_Lovin 的双人锁定手法）。
    TargetIndex.A = 对方 pawn；B = 自己的台位格（可空 = 贴脸兜底）；C = 发起方本人（认角色的记号）。
    两个 job 在发起的那一帧**同时**起来（KissUtility.Start），离开段也在 job 内走完：
    敌对单位的 think tree 只在 job 结束后才接管 ⇒ 停火窗口 = job 生命期。
    逻辑亲吻在表演结束时已完成；返程不算亲吻占用，释放双方目标/台位预订，并单独报告返回原位。
  -->
  <JobDef>
    <defName>MWAH_Kiss</defName>
    <driverClass>Mwah.JobDriver_Kiss</driverClass>
    <!-- A downed receiver waits in place. Crawling while reserved makes vanilla health end the job. -->
    <isCrawlingIfDowned>false</isCrawlingIfDowned>
    <reportString>kissing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>

  <!-- Single-actor jobs keep stable addon identity through JobDef metadata. -->
  <JobDef>
    <defName>MWAH_KissThing</defName>
    <modExtensions>
      <li Class="RimWorld.KissAddonJobExtension"><addon>MWAH_WallAddon</addon></li>
    </modExtensions>
    <driverClass>Mwah.JobDriver_KissThing</driverClass>
    <reportString>kissing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>
  <JobDef>
    <defName>MWAH_KissTree</defName>
    <driverClass>Mwah.JobDriver_KissThing</driverClass>
    <modExtensions>
      <li Class="RimWorld.KissAddonJobExtension"><addon>MWAH_TreeAddon</addon></li>
    </modExtensions>
    <reportString>kissing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>
</Defs>
