<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--
    亲吻 job。双方各自跑同一个 JobDef（镜像 job，沿用原版 JobDriver_Lovin 的双人锁定手法）。
    TargetIndex.A = 对方 pawn。数值（时长/爱心间隔/心情时长）由 ModSettings 决定，job 本身不写死。
  -->
  <JobDef>
    <defName>MWAH_Kiss</defName>
    <driverClass>Mwah.JobDriver_Kiss</driverClass>
    <reportString>kissing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>

  <!--
    单人亲"非 pawn 目标"的共享 job（addon 族全用这一个：墙、将来的树……）。
    TargetIndex.A = 目标；认领它的 addon 由 KissThingAddons.For 按谓词解析。
    没有定台与回原位：只挑一格站定面向目标；结算走天意表（MWAH_FateDefs.xml）。
  -->
  <JobDef>
    <defName>MWAH_KissThing</defName>
    <driverClass>Mwah.JobDriver_KissThing</driverClass>
    <reportString>kissing TargetA.</reportString>
    <casualInterruptible>false</casualInterruptible>
    <playerInterruptible>true</playerInterruptible>
    <checkOverrideOnDamage>Always</checkOverrideOnDamage>
    <allowOpportunisticPrefix>false</allowOpportunisticPrefix>
    <alwaysShowReport>true</alwaysShowReport>
  </JobDef>
</Defs>
