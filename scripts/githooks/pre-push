#!/bin/sh
# Mwah pre-push: the privacy audit is not a memory exercise — it is part of the push.
# Two human skips in one day (2026-10-06) proved the manual ritual wrong, so the gate moved
# onto the dangerous operation itself: this hook runs the full-history privacy audit before
# any push and blocks on failure. The --no-verify escape hatch buys nothing: CI re-runs the
# same -FullHistory audit on a full clone.
# Install once per clone:  pwsh scripts/install-hooks.ps1
root=$(git rev-parse --show-toplevel)
pwsh -NoProfile -File "$root/scripts/privacy-audit.ps1" -FullHistory < /dev/null
code=$?
if [ $code -ne 0 ]; then
    echo "pre-push: privacy audit FAILED (exit $code) — push blocked." >&2
    echo "pre-push: fix the leak, or knowingly --no-verify and accept the CI red." >&2
fi
exit $code
